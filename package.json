{
	"name": "automait",
	"version": "1.0.0",
	"author": "Erik <erik@codekraft.it>",
	"license": "MIT",
	"description": "AI-powered Git commit workflow automation using local Ollama models",
	"type": "module",
	"main": "./lib/cli.cjs",
	"module": "./lib/cli.js",
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./lib/cli.js",
			"require": "./lib/cli.cjs"
		},
		"./*": {
			"import": "./lib/*.js",
			"require": "./lib/*.cjs"
		}
	},
	"files": [
		"lib/",
		"*.json",
		"*.md",
		".gitignore",
		"LICENSE"
	],
	"bin": {
		"automait": "./src/cli.js"
	},
	"scripts": {
		"start": "node src/cli.js",
		"build": "rimraf lib && npm run build-module",
		"lint": "npx @biomejs/biome check --write",
		"build-module": "tsdown"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/node": "^25.2.3",
		"esbuild": "^0.27.0",
		"rimraf": "^6.1.2",
		"tsdown": "^0.22.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"boxen": "^8.0.1",
		"chalk": "^5.6.2",
		"commander": "^15.0.0",
		"cosmiconfig": "^9.0.0",
		"ora": "^9.4.0",
		"simple-git": "^3.25.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"keywords": [
		"git",
		"commit",
		"ollama",
		"ai",
		"cli",
		"conventional-commits"
	]
}
